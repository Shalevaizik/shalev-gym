{
  "expo": {
    "name": "Shalev Gym",
    "slug": "shalev-gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Shalev Gym turns what you say into exercise logs.",
        "NSMicrophoneUsageDescription": "Shalev Gym uses the microphone so you can log exercises by voice."
      }
    },
    "android": {
      "package": "com.ohad1989.shalevgym",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 100,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Shalev Gym uses the microphone so you can log exercises by voice.",
          "speechRecognitionPermission": "Shalev Gym turns what you say into exercise logs."
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "scheme": "shalevgym",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c84357e7-26d2-4b11-9d87-110526be9e89"
      }
    },
    "owner": "shalevai"
  }
}
